<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Disk Visualizer · v0.2 Preview" Width="1320" Height="900" MinWidth="1120" MinHeight="840" WindowStartupLocation="CenterScreen"
        Background="#0D1420" Foreground="#E7ECF4" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#8C9BB1"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#DFE6F2"/><Setter Property="Background" Value="#202C3E"/>
      <Setter Property="BorderBrush" Value="#334159"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#CAB8FF"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#111A28"/><Setter Property="Foreground" Value="#E7ECF4"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#334159"/><Setter Property="Padding" Value="11,9"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#172131"/><Setter Property="Foreground" Value="#95A5BC"/><Setter Property="Padding" Value="10,12"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="11"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,10"/><Setter Property="Foreground" Value="#E1E7F1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#343450"/></Trigger></Style.Triggers></Style>
    <Style TargetType="DataGridRow"><Setter Property="Background" Value="Transparent"/><Setter Property="MinHeight" Value="44"/><Setter Property="ToolTip" Value="{Binding Details}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1E2B3E"/></Trigger></Style.Triggers></Style>
    <Style TargetType="ScrollViewer"><Setter Property="PanningMode" Value="VerticalOnly"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#111A28" BorderBrush="#253044" BorderThickness="0,0,1,0">
      <Grid Margin="20,28,20,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal"><Border Background="#AF96F8" CornerRadius="9" Width="32" Height="32"><TextBlock Text="◉" Foreground="#191229" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="disk visualizer" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,0"/></StackPanel>
          <TextBlock Text="A little clarity. A lot of space." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,15,0,28"/>
          <Border Background="#292740" CornerRadius="7" Padding="13,11"><TextBlock Text="◉    Storage overview" Foreground="#C4B1FF"/></Border>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,30,0,0">
          <DockPanel><TextBlock Text="YOUR DRIVES" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="RefreshDrives" Content="↻" Padding="8,3" HorizontalAlignment="Right" BorderThickness="0" Background="Transparent" ToolTip="Refresh drives"/></DockPanel>
          <StackPanel x:Name="DriveList" Margin="0,12,0,0"/>
          <Button x:Name="Duplicates" Content="Find duplicate files" Margin="0,12,0,0" ToolTip="Compare file contents across the scanned location"/><Button x:Name="SidebarChoose" Content="+   Choose a folder" Margin="0,14,0,0" Background="Transparent"/>
        </StackPanel>
        <StackPanel Grid.Row="3"><Border Background="#182334" CornerRadius="8" Padding="13"><StackPanel><TextBlock Text="Local. Private. Yours." FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Your files stay on this PC.&#10;No account. No uploads." Foreground="{StaticResource Muted}" FontSize="11" LineHeight="19" Margin="0,7,0,0"/></StackPanel></Border><TextBlock Text="VERSION 0.2  /  WINDOWS PREVIEW" FontSize="9" Foreground="#66778E" Margin="0,18,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="30,27,30,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="Choose" Content="Choose folder" Margin="0,0,9,0"/><Button x:Name="Scan" Content="Scan folder" Background="#AF96F8" Foreground="#1B1530" BorderBrush="#AF96F8"/><Button x:Name="Cancel" Content="Cancel scan" Visibility="Collapsed" Margin="9,0,0,0"/></StackPanel>
        <StackPanel><TextBlock Text="Make room for what matters." FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Explore your storage, one layer at a time." Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
      </DockPanel>
      <Grid Grid.Row="1" Margin="0,25,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#172131" BorderBrush="#28344A" BorderThickness="1" CornerRadius="10" Padding="19,15"><StackPanel><TextBlock Text="FILE SIZE" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="TotalSize" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,3"/><TextBlock x:Name="DiskTotal" Text="Size on disk: not measured yet" Foreground="#8C9BB1" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
        <Border Grid.Column="2" Background="#172131" BorderBrush="#28344A" BorderThickness="1" CornerRadius="10" Padding="19,15"><StackPanel><TextBlock Text="ITEMS DISCOVERED" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ItemCount" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,3"/><TextBlock x:Name="Duration" Text="Files and folders" Foreground="#8C9BB1" FontSize="11"/></StackPanel></Border>
        <Border Grid.Column="4" Background="#172131" BorderBrush="#28344A" BorderThickness="1" CornerRadius="10" Padding="19,15"><StackPanel><TextBlock Text="SCAN COVERAGE" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="Coverage" Text="Ready" FontSize="29" FontWeight="SemiBold" Foreground="#70D8C1" Margin="0,5,0,3"/><Button x:Name="Issues" Content="No scan yet" HorizontalAlignment="Left" Padding="0" BorderThickness="0" Background="Transparent" Foreground="#8C9BB1" FontSize="11"/></StackPanel></Border>
      </Grid>
      <Grid Grid.Row="2" Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="Up" Content="↑" ToolTip="Parent folder (Alt+Up)" Margin="0,0,9,0"/><TextBox x:Name="PathInput" Grid.Column="1" AutomationProperties.Name="Folder or drive path" ToolTip="Enter a folder or drive path and press Enter"/></Grid>
      <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="1.12*" MinWidth="280"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*" MinWidth="280"/></Grid.ColumnDefinitions>
        <Border Background="#131C2A" BorderBrush="#28344A" BorderThickness="1" CornerRadius="11"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="19,17,19,0"><TextBlock Text="Storage map" FontWeight="SemiBold" FontSize="15"/><CheckBox x:Name="DiskMetric" Content="Size on disk" IsEnabled="False" HorizontalAlignment="Right" Foreground="#B9A5F8" FontSize="11" ToolTip="Use measured disk allocation for the chart. Partial measurements show known bytes only."/></DockPanel>
          <Grid x:Name="ChartHost" Grid.Row="1" MinHeight="200"/>
          <StackPanel Grid.Row="2" Margin="19,0,19,17"><TextBlock x:Name="HoverName" Text="Choose a folder or drive to get started" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock x:Name="HoverSize" Text="Click to select · double-click a folder to explore" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
        </Grid></Border>
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="Transparent" ResizeBehavior="PreviousAndNext"/>
        <Border Grid.Column="2" Background="#131C2A" BorderBrush="#28344A" BorderThickness="1" CornerRadius="11"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="17,17,17,12"><TextBlock x:Name="ListTitle" Text="Folder contents" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="ListCount" Text="0 items" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11"/></DockPanel>
          <Grid Grid.Row="1" Margin="15,0,15,13"><TextBox x:Name="Search" AutomationProperties.Name="Filter current folder" ToolTip="Filter names in this folder (Ctrl+F)"/><TextBlock Text="Filter this folder…" Foreground="#75869E" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
          <DataGrid Grid.Row="2" x:Name="Files" Background="Transparent" Foreground="#E7ECF4" BorderThickness="0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0" SelectionMode="Single" SelectionUnit="FullRow" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="NAME" Binding="{Binding DisplayName}" SortMemberPath="Name" Width="*" MinWidth="120"/>
              <DataGridTextColumn Header="FILE SIZE" Binding="{Binding SizeText}" SortMemberPath="Bytes" Width="90"/>
              <DataGridTextColumn Header="ON DISK" Binding="{Binding DiskText}" SortMemberPath="DiskBytes" Width="125"/>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="3" Margin="15,12,15,15"><TextBlock x:Name="SelectedPath" Text="Select an item to see its location." Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,11"/><WrapPanel><Button x:Name="Reveal" Content="Show in Explorer" Padding="10,8" Margin="0,0,8,0"/><Button x:Name="Collect" Content="Add to cleanup list" Padding="10,8"/></WrapPanel></StackPanel>
        </Grid></Border>
      </Grid>
      <Border Grid.Row="4" x:Name="CollectionDrop" AllowDrop="True" Background="#1D2235" BorderBrush="#3B3553" BorderThickness="1" CornerRadius="9" Padding="17,12" Margin="0,17,0,0"><DockPanel><Button x:Name="Review" Content="Review items" DockPanel.Dock="Right" Padding="12,7" Background="#35304D" BorderBrush="#4D416D"/><StackPanel VerticalAlignment="Center"><TextBlock x:Name="CollectionSummary" Text="Cleanup list  ·  0 items" FontWeight="SemiBold" Foreground="#CCBFF1"/><TextBlock Text="Drag items here to review. This preview does not delete files." Foreground="#9D94B4" FontSize="11" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
      <DockPanel Grid.Row="5" Margin="0,12,0,0"><TextBlock x:Name="Status" Text="Ready when you are. Choose a folder or select a drive." Foreground="#8696AC" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="READ-ONLY PREVIEW" Foreground="#697990" FontSize="9" HorizontalAlignment="Right" Margin="10,0,0,0"/></DockPanel>
    </Grid>
  </Grid>
</Window>
